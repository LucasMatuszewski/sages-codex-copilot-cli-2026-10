# TEACHING COMPARISON ONLY. Do not install this entire file as an active policy.
# Claude Bash allow -> Codex allow: syntactic mapping with different approval semantics.
# Broad allowances can bypass the sandbox when there are no denied-read restrictions.
# In 0.162.1, active denied reads must survive allow rules and approved escalation.
# These rules do not implement Read/Edit/Write/WebFetch; see permissions.toml.
# Source: course-materials/agent-configs/claude/settings.json.
# Colon-star becomes trailing argv; there are no wildcard strings in these patterns.
# Even Claude's exact-looking Bash(pwd) maps to a Codex PREFIX, not exact argv length.

# ALLOW command mappings
prefix_rule(pattern=["cat"], decision="allow")  # Bash(cat:*)
prefix_rule(pattern=["ls"], decision="allow")  # Bash(ls:*)
prefix_rule(pattern=["find"], decision="allow")  # Bash(find:*)
prefix_rule(pattern=["grep"], decision="allow")  # Bash(grep:*)
prefix_rule(pattern=["echo"], decision="allow")  # Bash(echo:*)
prefix_rule(pattern=["pwd"], decision="allow")  # Bash(pwd)
prefix_rule(pattern=["wc"], decision="allow")  # Bash(wc:*)
prefix_rule(pattern=["head"], decision="allow")  # Bash(head:*)
prefix_rule(pattern=["tail"], decision="allow")  # Bash(tail:*)
prefix_rule(pattern=["diff"], decision="allow")  # Bash(diff:*)
prefix_rule(pattern=["git", "status"], decision="allow")  # Bash(git status:*)
prefix_rule(pattern=["git", "log"], decision="allow")  # Bash(git log:*)
prefix_rule(pattern=["git", "diff"], decision="allow")  # Bash(git diff:*)
prefix_rule(pattern=["git", "show"], decision="allow")  # Bash(git show:*)
prefix_rule(pattern=["git", "branch"], decision="allow")  # Bash(git branch:*)
prefix_rule(pattern=["git", "stash", "list"], decision="allow")  # Bash(git stash list:*)
prefix_rule(pattern=["git", "add"], decision="allow")  # Bash(git add:*)
prefix_rule(pattern=["git", "commit"], decision="allow")  # Bash(git commit:*)
prefix_rule(pattern=["git", "checkout"], decision="allow")  # Bash(git checkout:*)
prefix_rule(pattern=["git", "switch"], decision="allow")  # Bash(git switch:*)
prefix_rule(pattern=["git", "restore"], decision="allow")  # Bash(git restore:*)
prefix_rule(pattern=["git", "fetch"], decision="allow")  # Bash(git fetch:*)
prefix_rule(pattern=["git", "merge"], decision="allow")  # Bash(git merge:*)
prefix_rule(pattern=["git", "rebase"], decision="allow")  # Bash(git rebase:*)
prefix_rule(pattern=["npm", "install"], decision="allow")  # Bash(npm install:*)
prefix_rule(pattern=["npm", "run"], decision="allow")  # Bash(npm run:*)
prefix_rule(pattern=["npm", "test"], decision="allow")  # Bash(npm test:*)
prefix_rule(pattern=["npm", "audit"], decision="allow")  # Bash(npm audit:*)
prefix_rule(pattern=["npx"], decision="allow")  # Bash(npx:*)
prefix_rule(pattern=["pnpm", "install"], decision="allow")  # Bash(pnpm install:*)
prefix_rule(pattern=["pnpm", "run"], decision="allow")  # Bash(pnpm run:*)
prefix_rule(pattern=["pnpm", "test"], decision="allow")  # Bash(pnpm test:*)
prefix_rule(pattern=["yarn", "install"], decision="allow")  # Bash(yarn install:*)
prefix_rule(pattern=["yarn", "run"], decision="allow")  # Bash(yarn run:*)
prefix_rule(pattern=["tsc"], decision="allow")  # Bash(tsc:*)
prefix_rule(pattern=["eslint"], decision="allow")  # Bash(eslint:*)
prefix_rule(pattern=["prettier"], decision="allow")  # Bash(prettier:*)
prefix_rule(pattern=["jest"], decision="allow")  # Bash(jest:*)
prefix_rule(pattern=["vitest"], decision="allow")  # Bash(vitest:*)
prefix_rule(pattern=["next"], decision="allow")  # Bash(next:*)
prefix_rule(pattern=["turbo"], decision="allow")  # Bash(turbo:*)
prefix_rule(pattern=["tsx"], decision="allow")  # Bash(tsx:*)
prefix_rule(pattern=["node"], decision="allow")  # Bash(node:*)
prefix_rule(pattern=["python"], decision="allow")  # Bash(python:*)
prefix_rule(pattern=["python3"], decision="allow")  # Bash(python3:*)
prefix_rule(pattern=["pip", "install"], decision="allow")  # Bash(pip install:*)
prefix_rule(pattern=["uv"], decision="allow")  # Bash(uv:*)
prefix_rule(pattern=["pytest"], decision="allow")  # Bash(pytest:*)
prefix_rule(pattern=["docker", "ps"], decision="allow")  # Bash(docker ps:*)
prefix_rule(pattern=["docker", "logs"], decision="allow")  # Bash(docker logs:*)
prefix_rule(pattern=["docker", "inspect"], decision="allow")  # Bash(docker inspect:*)
prefix_rule(pattern=["docker", "images"], decision="allow")  # Bash(docker images:*)
prefix_rule(pattern=["which"], decision="allow")  # Bash(which:*)
prefix_rule(pattern=["date"], decision="allow")  # Bash(date)
prefix_rule(pattern=["whoami"], decision="allow")  # Bash(whoami)
prefix_rule(pattern=["export"], decision="allow")  # Bash(export:*)

# DENY command mappings
prefix_rule(pattern=["env"], decision="forbidden")  # Bash(env:*)
prefix_rule(pattern=["printenv"], decision="forbidden")  # Bash(printenv:*)
prefix_rule(pattern=["git", "push"], decision="forbidden")  # Bash(git push:*)
prefix_rule(pattern=["git", "push", "--force"], decision="forbidden")  # Bash(git push --force:*)
prefix_rule(pattern=["git", "reset", "--hard"], decision="forbidden")  # Bash(git reset --hard:*)
prefix_rule(pattern=["chmod"], decision="forbidden")  # Bash(chmod:*)
prefix_rule(pattern=["chown"], decision="forbidden")  # Bash(chown:*)
prefix_rule(pattern=["sudo"], decision="forbidden")  # Bash(sudo:*)
prefix_rule(pattern=["curl"], decision="forbidden")  # Bash(curl:*)
prefix_rule(pattern=["wget"], decision="forbidden")  # Bash(wget:*)
prefix_rule(pattern=["ssh"], decision="forbidden")  # Bash(ssh:*)
prefix_rule(pattern=["scp"], decision="forbidden")  # Bash(scp:*)
prefix_rule(pattern=["docker", "run"], decision="forbidden")  # Bash(docker run:*)
prefix_rule(pattern=["docker", "rm"], decision="forbidden")  # Bash(docker rm:*)
prefix_rule(pattern=["docker", "rmi"], decision="forbidden")  # Bash(docker rmi:*)
prefix_rule(pattern=["docker-compose", "down"], decision="forbidden")  # Bash(docker-compose down:*)

# ASK examples from the root .claude/settings.json.
prefix_rule(pattern=["git", "worktree", "add"], decision="prompt", justification="Ask before creating a worktree.", match=["git worktree add ../example"])
# Claude's git -C * worktree add * has no literal wildcard-token equivalent.
prefix_rule(pattern=["git", "-C"], decision="prompt", justification="Review the directory and operation, including worktree creation.", match=["git -C . worktree add ../example"])
# EnterWorktree and Agent(isolation:worktree) are Claude tool names, not Codex argv.
