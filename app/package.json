{
  "name": "sages-angular-chat",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others 'ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.conf.json' 'tsx watch src/server.ts'",
    "build:app": "ng build --conditions browser",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm run build:app && pnpm run build:server",
    "watch": "ng build --watch --configuration development",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.server.tsbuildinfo',{force:true})\""
  },
  "private": true,
  "dependencies": {
    "@ai-sdk/angular": "3.0.142",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/router": "21.2.24",
    "ai": "7.0.142",
    "dotenv": "16.4.5",
    "express": "5.0.1",
    "tslib": "^2.8.1",
    "zod": "3.25.76",
    "@ai-sdk/gateway": "4.0.115",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@types/express": "5.0.0",
    "@types/node": "22.19.19",
    "concurrently": "^9.2.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
